{"version":1,"exportedAt":"2026-11-11T23:20:21.779Z","table":"gallery","rows":[{"id":"b2889d76-a390-4875-b548-a38e0f3f9c35","title":"فيضان 1988","source":"مدثر علي آرقاوي","excerpt":"كان فيضان عام ١٩٨٨ نقطة فاصلة في تاريخ شبتوت. غمرت المياه البيوت والمزارع، وتضرر الجامع والشفخانة ومكتب المشروع والمدرسة، وتضررت الدكاكين والمنازل الخاصة. واضطر الأطفال إلى الدراسة تحت الخيام ثلاث سنوات، وبدأت المنطقة مرحلة طويلة من إعادة الإعمار شملت المرافق العامة والبيوت ومبنى التعاون. وخسر المزارعون محاصيلهم وأعلافهم، فباع بعضهم حيواناته، وأنفق آخرون ما يملكون على شراء العلف. وبقيت بعض خسائر المواطنين دون تعويض حتى وقت كتابة الشهادة، وتوضح الشهادة أن الكوارث لا تنتهي بانحسار المياه، فبعد الخطر المباشر تبدأ مرحلة أخرى من الإصلاح والتعويض واستعادة التعليم والزراعة والخدمات.","category":"events","label":"حدث","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1792050673508-7a3cb130c3c8.jpg","extra":{"important":true},"created_at":"2026-10-15T07:53:15.515291+00:00","updated_at":"2026-11-10T20:52:59.699946+00:00"},{"id":"035dc566-6151-466d-867d-d49148c628da","title":"فيضان 1988","source":"مدثر علي آرقاوي","excerpt":"هذه الصورة تبين حجم أضرار الفيضان","category":"events","label":"حدث","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1792050832166-593d7b9e4884.jpg","extra":{"important":false},"created_at":"2026-10-15T07:55:30.399189+00:00","updated_at":"2026-11-10T20:39:24.22844+00:00"},{"id":"95aefb67-a29e-4be7-84d9-561735e5b9b4","title":"الساقية قديمًا قبل الطلمبات","source":"إعلام الرابطة","excerpt":"هكذا كانت الساقية قبل \"بوابير الجاز\"","category":"old","label":"صورة قديمة","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1792057395201-c890b11293b4.jpg","extra":{"important":false},"created_at":"2026-10-15T09:44:24.992915+00:00","updated_at":"2026-11-10T20:39:23.757908+00:00"},{"id":"a95e2d85-fd1d-4400-bd96-b7886e96c8d6","title":"شيخ الأمين حامد","source":"مدثر علي آرقاوي","excerpt":"كان الشيخ الأمين حامد أول إمام وخطيب من أبناء التنجلاب يعتلي منبر المسجد ويخطب بالناس، كما كان يصلي بهم الجمعة والعيدين، ويصلي على الجنائز. وتولى كذلك مهمة الإفتاء في القرية، ولا سيما في مسائل الميراث، فكان مرجعًا دينيًا واجتماعيًا لأهلها.","category":"figures","label":"شخصية","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1792057731976-e09341816773.jpg","extra":{"important":true},"created_at":"2026-10-15T09:49:01.111413+00:00","updated_at":"2026-11-10T20:52:59.053509+00:00"},{"id":"ff233a54-c885-442e-ae3e-b255c909b68e","title":"السفر زمان","source":"مدثر علي آرقاوي","excerpt":"السفر زمان عام 85، يقال أن هذا اللوري ملك لحسن صديق وكان يقوده؛ بلال الجاك","category":"old","label":"صورة قديمة","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1792598753138-3e4907c19185.webp","extra":{"important":false},"created_at":"2026-10-21T16:06:56.372336+00:00","updated_at":"2026-11-10T20:39:24.65522+00:00"},{"id":"43818b06-9708-4dd7-a7a2-943524ff5085","title":"المقابر القديمة","source":"مدثر علي آرقاوي","excerpt":"تقريبًا تم إفتتاحها سنة 1950، وقبلها كُنا ندفن موتانا في الخندق، بينما المقابر الجديدة الأن؛ بدأ الدفن فيها عام 1987 تقريبًا.","category":"places","label":"معلم","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1792741542323-a49664605212.webp","extra":{"important":false},"created_at":"2026-10-23T07:57:52.311049+00:00","updated_at":"2026-11-10T20:39:25.87738+00:00"},{"id":"975628f5-ba09-4456-bc5b-c16e55cbb5ea","title":"فوانيس الجاز","source":"مدثر علي آرقاوي","excerpt":"أحجام وأشكال للفوانيس الجاز التي كانت تنير منازلنا قبل الكهرباء","category":"old","label":"صورة قديمة","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1792741954115-5d3b4baf8e91.webp","extra":{"important":false},"created_at":"2026-10-23T07:57:52.680737+00:00","updated_at":"2026-11-10T20:39:25.478497+00:00"},{"id":"ab30458e-a35e-4a33-9d96-885ef64651dc","title":"سبيل مصطفنتود","source":"مدثر علي آرقاوي","excerpt":"تجمع للونسة، ذاد الظمأن، ذكريات جميلة","category":"places","label":"معلم","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1792741995728-2afd3c5463aa.webp","extra":{"important":false},"created_at":"2026-10-23T07:57:53.008448+00:00","updated_at":"2026-11-08T09:22:43.778486+00:00"},{"id":"cbd16d20-bfbc-4cc6-b26b-253e1413fdf2","title":"الزارعة","source":"مدثر علي آرقاوي","excerpt":"الزراعة أساس الحياة في شبتوت بحري قديما","category":"old","label":"صورة قديمة","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1792742203821-6bdd18e5ccfd.webp","extra":{"important":false},"created_at":"2026-10-23T07:57:53.404686+00:00","updated_at":"2026-11-08T09:22:43.339596+00:00"},{"id":"bc0e3efa-d91e-4a29-9c82-c19cb138143e","title":"صورة مهيبة","source":"مدثر علي آرقاوي","excerpt":"للعم إبراهيم الشفا رحمة الله عليه","category":"figures","label":"شخصية","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1792742343393-fbb93a766091.webp","extra":{},"created_at":"2026-10-23T08:25:15.508101+00:00","updated_at":"2026-10-23T08:25:15.508101+00:00"},{"id":"92f5f195-c830-4ae5-965e-18edc4ea67fd","title":"معبر ساقية شاهين","source":"مدثر علي آرقاوي","excerpt":"","category":"places","label":"معلم","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1792742495688-c9a969058b3f.webp","extra":{"important":false},"created_at":"2026-10-23T08:25:16.612726+00:00","updated_at":"2026-11-10T20:39:26.566463+00:00"},{"id":"4c05daec-49cc-4ff4-8b0d-2afda85d5876","title":"صورة في شبتوت","source":"مدثر علي آرقاوي","excerpt":"لمشاهدة زاوج أحد أبناء القرية","category":"group","label":"صورة جماعية","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1792742562318-be95ade76375.webp","extra":{"important":false},"created_at":"2026-10-23T08:25:16.872974+00:00","updated_at":"2026-11-10T20:39:27.353678+00:00"},{"id":"ea4c8507-8440-4187-aae4-2b86ec7c6884","title":"عوض خليل أرقاوي","source":"مدثر علي آرقاوي","excerpt":"كان رجلًا جمع بين الزعامة والتواضع، وبين الخبرة الزراعية والعمل والانضباط، وبين المعرفة بالأنساب واللغة وحب الخير. بدأ حياته طالبًا متفوقًا، ثم مزارعًا وراعيًا لإخوته، وشرطيًا وبناءً وصاحب عمل ومغتربًا. ولذلك بقيت سيرته جزءًا من تاريخ شبتوت بحري وذاكرتها، وظل أثره حاضرًا في قلوب أهلها","category":"figures","label":"شخصية","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1793261350530-849f7d7e1d63.webp","extra":{"important":true},"created_at":"2026-10-23T08:25:17.170886+00:00","updated_at":"2026-11-11T09:09:59.711876+00:00"},{"id":"a479dc0d-4131-4d12-a959-e77ad764754b","title":"نجوم شبتوت 2003","source":"مدثر علي آرقاوي","excerpt":"نسناس،  هاشم محمد حمد ،ماهر محمد حمد، معاوية محمد حمد","category":"group","label":"صورة جماعية","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1792742789096-776232c0f66b.webp","extra":{"important":false},"created_at":"2026-10-23T08:25:17.535632+00:00","updated_at":"2026-11-10T20:39:28.123106+00:00"},{"id":"804d5436-02ae-4824-86eb-faeb8c6b5e32","title":"دكان إدريس عبدالمنطلب","source":"مدثر علي آرقاوي","excerpt":"دكان إدريس عبدالمطلب كان شمال دكان عمنا عوض ابراهيم  رحمهم الله","category":"places","label":"معلم","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1792743017074-871aab969466.webp","extra":{"important":false},"created_at":"2026-10-23T08:25:18.213606+00:00","updated_at":"2026-11-10T20:39:27.747519+00:00"},{"id":"15d57484-cd71-4db5-9d4f-b54079dc5f3f","title":"د. محمود ضوي","source":"مدثر علي آرقاوي","excerpt":"نموذجًا للمثقف الذي جمع بين الشعر الفصيح، والقصة القصيرة، والفكر الإسلامي، والبحث في التراث والتاريخ. كما يمتلك اهتمام بتاريخ القرية والمنطقة النوبية والتعريف بثقافة المجتمع وموروثه، وتتوزع تجربته بين دواوين الشعر، والمجموعة القصصية، والمقالات، والبرامج الإذاعية، والبحث في الفكر الإسلامي والتاريخ المحلي.","category":"figures","label":"شخصية","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1792744896622-bfd3196792a0.webp","extra":{"important":false},"created_at":"2026-10-23T08:44:18.898368+00:00","updated_at":"2026-11-10T20:39:28.855866+00:00"},{"id":"42926b4b-d636-4dc1-9fd7-faf502632926","title":"باب منزل قديم","source":"مدثر علي آرقاوي","excerpt":"منزل الجد خليل آرقاوي","category":"places","label":"معلم","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1793258876503-f5b5c644bd3f.webp","extra":{"important":false},"created_at":"2026-10-29T07:28:52.978701+00:00","updated_at":"2026-11-10T20:39:28.478388+00:00"},{"id":"e420af6f-5c79-46db-963e-05a57d9ffb35","title":"(اولل) أو المعلاق","source":"مدثر علي آرقاوي","excerpt":"من منزل تاتا عبيد الله","category":"old","label":"صورة قديمة","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1793259002708-8b8dd25d0c89.webp","extra":{"important":false},"created_at":"2026-10-29T07:31:17.651854+00:00","updated_at":"2026-11-10T20:39:29.221953+00:00"},{"id":"6e8cbacf-e0e0-419d-854b-ffa80bb8daa6","title":"باب المسجد العتيق","source":"مدثر علي آرقاوي","excerpt":"","category":"places","label":"معلم","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1793259119004-2eafa8720e60.webp","extra":{},"created_at":"2026-10-29T07:32:24.307481+00:00","updated_at":"2026-10-29T07:32:24.307481+00:00"},{"id":"472f4373-116b-4fa5-997a-2b4dfa7eb0df","title":"الفرن البلدي القديم","source":"مدثر علي آرقاوي","excerpt":"","category":"old","label":"صورة قديمة","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1793259187340-e38be2d02d5e.webp","extra":{"important":true},"created_at":"2026-10-29T07:33:26.552736+00:00","updated_at":"2026-11-08T06:24:52.820089+00:00"},{"id":"d50f56a4-f529-4021-9aa4-ecd0930c5fcc","title":"محمد فلاح","source":"مدثر علي آرقاوي","excerpt":"كان محمد فلاح من الشخصيات المؤثرة في تاريخ كرة القدم بشبتوت بحري، فقد أسهم في صقل المواهب وتدريب أجيال متعاقبة من اللاعبين، واهتم إلى جانب المهارة الرياضية بالانضباط والروح الرياضية واحترام الآخرين، وربط بين ممارسة كرة القدم والالتزام بالخلوة، وبفضل جهود المدربين والمهتمين بالرياضة، مثل محمد فلاح، ظهرت أجيال من لاعبي شبتوت بحري الذين واصلوا مسيرتهم في أندية القولد ودنقلا والخرطوم، وأسهموا في حفظ مكانة شبتوت في ملاعب كرة القدم.","category":"figures","label":"شخصية","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1794129131037-f166e15ddc37.webp","extra":{"important":true},"created_at":"2026-10-29T07:35:29.602431+00:00","updated_at":"2026-11-10T20:53:00.498391+00:00"},{"id":"b07f0589-24e8-47a7-89cf-ca9f5474f8f2","title":"تُكل أو دِنكا، المطبخ قديما","source":"مدثر علي آرقاوي","excerpt":"","category":"old","label":"صورة قديمة","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1793260038479-04446224968c.webp","extra":{"important":false},"created_at":"2026-10-29T07:38:34.820156+00:00","updated_at":"2026-11-10T20:39:29.967676+00:00"},{"id":"0ed1cfac-7cb0-49d6-8261-9ae9cfbb61d0","title":"مقابر الشيخ سعد في الثمانينيات","source":"مدثر علي آرقاوي","excerpt":"","category":"places","label":"معلم","image":"https://rtgrkugcokqxseedzunr.supabase.co/storage/v1/object/public/akdar-images/gallery/1793260064215-7776a98d5d59.webp","extra":{"important":false},"created_at":"2026-10-29T07:48:45.840172+00:00","updated_at":"2026-11-10T20:39:30.312371+00:00"},{"id":"baff3328-3bc4-4015-a980-5baceb8fae3b","title":"صورة جمعت عدد من أجدادنا","source":"مدثر علي آرقاوي","excerpt":"هذا الجمع من اجداد القريه بالترتيب من اليمين علي تنجلاب  .عبدالله عمر .عصام ارقاوي. عبدالرحمن انجليز .عبدالرحيم تنجلاب.  حسن عباس. 